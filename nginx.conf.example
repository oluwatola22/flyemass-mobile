# =========================================================================
# FlyeMass Production Nginx Configuration
# Independent Production Domains with Shared Authoritative Backend
# - Customer Mobile App:      https://app.flyemass.com
# - Admin Operations Portal:  https://admin.flyemass.com
# - Shared Authoritative API: https://api.flyemass.com
# =========================================================================

# -------------------------------------------------------------
# 1. UPSTREAM BACKEND DEFINITION
# -------------------------------------------------------------
upstream flyemass_backend {
    server 127.0.0.1:5050;
    keepalive 32;
}

# -------------------------------------------------------------
# 2. SHARED SSL SECURITY PARAMETERS
# -------------------------------------------------------------
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers on;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# -------------------------------------------------------------
# 3. HTTP TO HTTPS GLOBAL REDIRECT
# -------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name app.flyemass.com admin.flyemass.com api.flyemass.com;
    return 301 https://$host$request_uri;
}

# -------------------------------------------------------------
# 4. CUSTOMER MOBILE APP (https://app.flyemass.com)
# -------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.flyemass.com;

    ssl_certificate /etc/letsencrypt/live/app.flyemass.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.flyemass.com/privkey.pem;

    root /var/www/flyemass/dist;
    index index.html;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Explicitly block access to admin assets from mobile domain
    location = /admin.html {
        return 404;
    }
    location ^~ /admin/ {
        return 404;
    }

    # Static assets caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform, immutable";
    }

    # SPA routing fallback for mobile app
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# -------------------------------------------------------------
# 5. ADMIN OPERATIONS WORKSPACE (https://admin.flyemass.com)
# -------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.flyemass.com;

    ssl_certificate /etc/letsencrypt/live/admin.flyemass.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.flyemass.com/privkey.pem;

    root /var/www/flyemass/dist;
    index admin.html index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Static assets caching
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform, immutable";
    }

    # SPA routing fallback for Admin Workspace
    location / {
        try_files $uri $uri/ /admin.html;
    }
}

# -------------------------------------------------------------
# 6. AUTHORITATIVE BACKEND & GATEWAY (https://api.flyemass.com)
# -------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.flyemass.com;

    ssl_certificate /etc/letsencrypt/live/api.flyemass.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.flyemass.com/privkey.pem;

    client_max_body_size 25M;

    # Real-Time SSE Stream Support (/api/db/stream)
    location /api/db/stream {
        proxy_pass http://flyemass_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 86400s;
    }

    # General API Requests Proxy
    location /api/ {
        proxy_pass http://flyemass_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        return 404;
    }
}
