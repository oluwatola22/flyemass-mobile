# =========================================================================
# FlyeMass Environment Configuration Template (.env.example)
# Copy this file to .env.development, .env.staging, or .env.production
# and populate with environment-appropriate values.
# NEVER commit production secrets or real API keys to version control.
# =========================================================================

# -------------------------------------------------------------
# 1. CORE SERVER & RUNTIME PORTS
# -------------------------------------------------------------
PORT=5050
NODE_ENV=development
VITE_BACKEND_URL=http://localhost:5050
VITE_MOBILE_PORT=3030
VITE_ADMIN_PORT=5173
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:5173

# -------------------------------------------------------------
# 2. FILE PERSISTENCE, WAL & SNAPSHOT REPOSITORY
# -------------------------------------------------------------
DB_FILE=./db-state.json
WAL_FILE=./db-transactions.wal.jsonl
BACKUPS_DIR=./backups
BACKUP_RETENTION_COUNT=15
SNAPSHOT_FREQUENCY_MINUTES=15

# -------------------------------------------------------------
# 3. NIGERIAN BANKING RAILS (Providus, Monnify, Korapay, NIBSS)
# -------------------------------------------------------------
# Providus Bank Virtual Accounts & Dynamic Settlement
PROVIDUS_CLIENT_ID=your_providus_client_id
PROVIDUS_CLIENT_SECRET=your_providus_client_secret
PROVIDUS_WEBHOOK_SECRET=your_providus_hmac_sha256_webhook_secret
PROVIDUS_BASE_URL=https://api.providusbank.com

# Monnify Multi-Channel Payment Gateway
MONNIFY_API_KEY=your_monnify_api_key
MONNIFY_SECRET_KEY=your_monnify_secret_key
MONNIFY_WEBHOOK_SECRET=your_monnify_hmac_sha512_webhook_secret
MONNIFY_CONTRACT_CODE=your_monnify_contract_code
MONNIFY_BASE_URL=https://api.monnify.com

# Korapay Card & Bank Checkout
KORAPAY_PUBLIC_KEY=pk_test_your_korapay_public_key
KORAPAY_SECRET_KEY=sk_test_your_korapay_secret_key
KORAPAY_WEBHOOK_SECRET=your_korapay_hmac_sha256_webhook_secret
KORAPAY_BASE_URL=https://api.korapay.com

# NIBSS Instant Payment (Direct Clearing)
NIBSS_INSTANT_PAYMENT_URL=https://nip.nibss-plc.com.ng/v2
NIBSS_INSTITUTION_CODE=999001
NIBSS_ENCRYPTION_PRIVATE_KEY_PATH=./certs/nibss_private.key

# -------------------------------------------------------------
# 4. CHINA REMITTANCE & CROSS-BORDER RAILS (CNY / RMB)
# -------------------------------------------------------------
# China National Advanced Payment System (CNAPS)
CNAPS_PARTICIPANT_ID=your_cnaps_participant_id
CNAPS_CLEARING_ENDPOINT=https://sandbox.cnaps.pbc.gov.cn/v1
CNAPS_CERT_PATH=./certs/cnaps_client.p12

# Alipay Enterprise Cross-Border Rails (Sandbox / Production)
ALIPAY_APP_ID=your_alipay_enterprise_app_id
ALIPAY_MERCHANT_PRIVATE_KEY_PATH=./certs/alipay_rsa_private.pem
ALIPAY_MERCHANT_ENV=sandbox

# WeChat Pay Cross-Border Partner Rails
WECHAT_PAY_MCH_ID=your_wechat_merchant_id
WECHAT_PAY_API_V3_KEY=your_wechat_api_v3_key
WECHAT_PAY_SERIAL_NO=your_wechat_cert_serial_number
WECHAT_PAY_CERT_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_PARTNER_ENV=sandbox

# SAFE (State Administration of Foreign Exchange) Reporting
SAFE_REGULATORY_GATEWAY_MODE=sandbox
SAFE_REPORTING_API_URL=https://fx-safe.gov.cn/api/v2/declare
SAFE_ENTERPRISE_CODE=your_safe_corp_registration_code

# -------------------------------------------------------------
# 5. CRYPTOGRAPHY, PIN SECURITY & SUPER ADMIN DISASTER RECOVERY
# -------------------------------------------------------------
MASTER_RECOVERY_KEY=CHANGE_THIS_TO_A_SECURE_OFFLINE_RANDOM_SECRET
JWT_SIGNING_SECRET=change_to_strong_random_256_bit_secret
PIN_PEPPER_KEY=change_to_hardware_security_pepper
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# -------------------------------------------------------------
# 6. CLOUD STORAGE FOR SHIPMENT & REMITTANCE PROOFS
# -------------------------------------------------------------
S3_BUCKET_NAME=flyemass-trade-documents
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
