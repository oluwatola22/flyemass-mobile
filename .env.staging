# FlyeMass Staging & Pre-Production Environment Configuration
# Used for end-to-end sandbox verification and partner certification

# API Host
PORT=5050
VITE_BACKEND_URL=https://staging-api.flyemass.internal
NODE_ENV=staging

# Storage & Backup Architecture
DB_FILE=/var/data/flyemass/staging-db-state.json
WAL_FILE=/var/data/flyemass/staging-transactions.wal.jsonl
BACKUPS_DIR=/var/backups/flyemass/staging

# Payment Provider Test Credentials (UAT / Staging)
PROVIDUS_WEBHOOK_SECRET=PROVIDUS_UAT_SECRET_TEST_771829
MONNIFY_WEBHOOK_SECRET=MONNIFY_UAT_SECRET_TEST_551029
KORAPAY_WEBHOOK_SECRET=KORAPAY_UAT_SECRET_TEST_441920

# Emergency Recovery Key
MASTER_RECOVERY_KEY=STAGING-FLYE-MASTER-RECOVERY-KEY-2026

# Regulatory & Banking Switches
NIBSS_INSTANT_PAYMENT_URL=https://uat.nibss-plc.com.ng/nip/v2
SAFE_REGULATORY_GATEWAY_MODE=staging
