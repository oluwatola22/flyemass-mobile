# FlyeMass Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND FILL IN SECURE CREDENTIALS.
# NEVER COMMIT .env.production TO VERSION CONTROL.

# -------------------------------------------------------------
# 1. CORE SERVER & AUTHORITATIVE BACKEND
# -------------------------------------------------------------
PORT=5050
VITE_BACKEND_URL=https://api.flyemass.com
NODE_ENV=production
ALLOWED_ORIGINS=https://app.flyemass.com,https://admin.flyemass.com

# -------------------------------------------------------------
# 2. FILE PERSISTENCE, WAL & SNAPSHOT REPOSITORY
# -------------------------------------------------------------
DB_FILE=/var/flyemass/data/db-state.json
WAL_FILE=/var/flyemass/data/db-transactions.wal.jsonl
BACKUPS_DIR=/var/flyemass/backups
BACKUP_RETENTION_COUNT=30
SNAPSHOT_FREQUENCY_MINUTES=15

# -------------------------------------------------------------
# 3. NIGERIAN BANKING RAILS (NIP / NUBAN / NIBSS)
# -------------------------------------------------------------
# Providus Bank Virtual Accounts & Dynamic Settlement
PROVIDUS_CLIENT_ID=prod_client_id_here
PROVIDUS_CLIENT_SECRET=prod_client_secret_here
PROVIDUS_WEBHOOK_SECRET=replace_with_providus_hmac_sha256_key
PROVIDUS_BASE_URL=https://api.providusbank.com

# Monnify Multi-Account Ingestion
MONNIFY_API_KEY=prod_monnify_api_key_here
MONNIFY_SECRET_KEY=prod_monnify_secret_key_here
MONNIFY_WEBHOOK_SECRET=replace_with_monnify_hmac_sha512_key
MONNIFY_CONTRACT_CODE=prod_contract_code_here
MONNIFY_BASE_URL=https://api.monnify.com

# Korapay Card & Bank Checkout
KORAPAY_PUBLIC_KEY=pk_live_replace_with_korapay_public_key
KORAPAY_SECRET_KEY=sk_live_replace_with_korapay_secret_key
KORAPAY_WEBHOOK_SECRET=replace_with_korapay_hmac_sha256_key

# NIBSS Instant Payment (Direct Clearing)
NIBSS_INSTANT_PAYMENT_URL=https://nip.nibss-plc.com.ng/v2
NIBSS_INSTITUTION_CODE=999001
NIBSS_ENCRYPTION_PRIVATE_KEY_PATH=/var/flyemass/certs/nibss_private.key

# -------------------------------------------------------------
# 4. CHINA REMITTANCE & CROSS-BORDER RAILS (CNY / RMB)
# -------------------------------------------------------------
# China National Advanced Payment System (CNAPS)
CNAPS_PARTICIPANT_ID=CNAPS_PARTICIPANT_PRODUCTION_ID
CNAPS_GATEWAY_URL=https://gateway.cnaps.pbc.gov.cn/v1
CNAPS_CERT_PATH=/var/flyemass/certs/cnaps_client.p12

# Alipay Enterprise Cross-Border Direct Settlement
ALIPAY_APP_ID=alipay_enterprise_app_id
ALIPAY_MERCHANT_PRIVATE_KEY_PATH=/var/flyemass/certs/alipay_rsa_private.pem
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# WeChat Pay Cross-Border Partner Rails
WECHAT_PAY_MCH_ID=wechat_merchant_id
WECHAT_PAY_API_V3_KEY=wechat_api_v3_key
WECHAT_PAY_SERIAL_NO=wechat_cert_serial_number
WECHAT_PAY_CERT_KEY_PATH=/var/flyemass/certs/apiclient_key.pem

# SAFE (State Administration of Foreign Exchange) Reporting
SAFE_REGULATORY_GATEWAY_MODE=production
SAFE_REPORTING_API_URL=https://fx-safe.gov.cn/api/v2/declare
SAFE_ENTERPRISE_CODE=SAFE_CORP_REG_991823

# -------------------------------------------------------------
# 5. CRYPTOGRAPHY, PIN SECURITY & SUPER ADMIN DISASTER RECOVERY
# -------------------------------------------------------------
# Emergency Recovery Master Key (Must be kept in HSM or physical vault)
MASTER_RECOVERY_KEY=FLYE-VAULT-EMERGENCY-MASTER-RECOVERY-KEY-HEX-PROD-2026
JWT_SIGNING_SECRET=replace_with_strong_random_256_bit_secret
PIN_PEPPER_KEY=replace_with_hardware_security_pepper

# -------------------------------------------------------------
# 6. CLOUD STORAGE FOR SHIPMENT & REMITTANCE PROOFS
# -------------------------------------------------------------
S3_BUCKET_NAME=flyemass-trade-documents-production
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=prod_aws_access_key
AWS_SECRET_ACCESS_KEY=prod_aws_secret_key
