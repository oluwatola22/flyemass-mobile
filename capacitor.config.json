{
  "appId": "com.flyemass.trade",
  "appName": "FlyeMass",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0F172A",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F172A"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
